# Supabase project that issues the annotator identities. The Label Lab API
# validates the access token minted here, so both services must point at the
# same project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key

# Origin of the Label Lab API service (videos, media, annotations, session).
# Read at build time and used for the /labelling/api/* same-origin rewrite.
AMP_LABEL_LAB_API_ORIGIN=https://amp-label-lab.example.com
